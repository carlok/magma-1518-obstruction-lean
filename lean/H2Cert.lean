D is the 9x9 1518-cocycle matrix, E the 9x3 coboundary matrix, P (3x9) and Q (9x9) the certificate. Same ring arithmetic as L2Cert.lean.
-/
namespace H2

def R := List Int   -- always length 5

def radd (u v : List Int) : List Int := List.zipWith (· + ·) u v

def get (l : List Int) (i : Nat) : Int := l.getD i 0

/-- reduce a degree-≤8 coefficient list to degree ≤4 using b^5 = -b^3 + b^2 + 1 -/
def reduce (p : List Int) : List Int :=
  let p8 := get p 8; let p7 := get p 7; let p6 := get p 6; let p5 := get p 5
  -- b^5 = 1 + b^2 - b^3 ; b^6 = b + b^3 - b^4 ; b^7 = b^2 + b^4 - b^5 = b^2 + b^4 - 1 - b^2 + b^3 = -1 + b^3 + b^4 ;
  -- b^8 = -b + b^4 + b^5 = -b + b^4 + 1 + b^2 - b^3 = 1 - b + b^2 - b^3 + b^4
  [get p 0 + p5 - p7 + p8,
   get p 1 + p6 - p8,
   get p 2 + p5 + p8,
   get p 3 - p5 + p6 + p7 - p8,
   get p 4 - p6 + p7 + p8]

def rmul (u v : List Int) : List Int :=
  reduce ((List.range 9).map fun k =>
    ((List.range 5).map fun i => if k ≥ i ∧ k - i < 5 then get u i * get v (k - i) else 0).foldl (· + ·) 0)

def rzero : List Int := [0, 0, 0, 0, 0]

/-- (C * D) entry (i, j) = Σ_k C[i][k] * D[k][j] -/
def mulRow (crow : List (List Int)) (D : List (List (List Int))) (j : Nat) : List Int :=
  (List.zipWith (fun c drow => rmul c (drow.getD j rzero)) crow D).foldl radd rzero

def matMul (C D : List (List (List Int))) (ncols : Nat) : List (List (List Int)) :=
  C.map fun crow => (List.range ncols).map fun j => mulRow crow D j

def matAdd (X Y : List (List (List Int))) : List (List (List Int)) := List.zipWith (fun rx ry => List.zipWith radd rx ry) X Y

